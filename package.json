{
  "name": "rootmint-core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm --prefix web run build && tsc -b",
    "start": "node dist/index.js",
    "typecheck": "tsc -b --noEmit",
    "db:generate": "node scripts/generar-migracion.mjs",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed-bloques": "tsx src/db/seed-bloques.ts",
    "prueba:costo": "tsx src/bloques/costo.prueba.ts",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "start:prod": "node dist/db/migrate.js && node dist/index.js",
    "db:seed-bloques:prod": "node dist/db/seed-bloques.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^10.1.3",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.1.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}