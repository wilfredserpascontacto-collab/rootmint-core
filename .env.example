DATABASE_URL=postgres://rootmint:rootmint@localhost:5432/rootmint_fenix
PORT=3000
HOST=0.0.0.0

# Que piezas tiene ESTE despliegue (ver src/modulos.ts). Lo decide quien despliega, no el cliente.
#   comercial  clientes, cotizaciones, facturas, catalogo
#   bloques    la fabrica: lotes, recetas, patio, ordenes de produccion
#   servicio   instalaciones (y despues garantias, mantenimiento, visitas); pide «comercial»
# Sin la variable se enciende «comercial,bloques»: lo que corria antes de que existiera
# el interruptor. Un modulo nuevo NO se enciende solo.
# ROOTMINT_MODULES=comercial,servicio

# Como se llama el sistema en pantalla. Sin la variable se usa el nombre de la
# empresa en «Mi empresa», y si tampoco hay, «RootMint».
# ROOTMINT_BRAND=Grupo Titán
